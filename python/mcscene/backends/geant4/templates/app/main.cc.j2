{#- Окно Geant4 с моделью (scene_app). Из данных сцены здесь только шапка. -#}
{% import "_common.j2" as common with context %}
{{ common.header("//") }}
//
// Демо-приложение: окно Geant4 с геометрией сцены.
// Частиц пока нет — только визуализация геометрии; источник частиц и
// /run/beamOn появятся отдельным шагом.
//
// Запуск:
//   ./scene_app               — окно (Qt), выполняется vis.mac
//   ./scene_app batch.mac     — без окна: построить геометрию и выйти (для проверок)

#include "G4RunManager.hh"
#include "G4RunManagerFactory.hh"
#include "G4String.hh"
#include "G4UIExecutive.hh"
#include "G4UImanager.hh"
#include "G4VisExecutive.hh"
#include "QBBC.hh"

#include "DetectorConstruction.hh"   // user/: наследник сгенерированной геометрии

int main(int argc, char** argv) {
  G4UIExecutive* ui = (argc == 1) ? new G4UIExecutive(argc, argv) : nullptr;

  G4RunManager* runManager = G4RunManagerFactory::CreateRunManager(G4RunManagerType::Serial);
  runManager->SetUserInitialization(new DetectorConstruction);
  // Geant4 не строит геометрию (/run/initialize) без физического листа,
  // даже если частиц не будет. QBBC — стандартный лист, как в примере B1.
  runManager->SetUserInitialization(new QBBC(0));

  auto* visManager = new G4VisExecutive("quiet");
  visManager->Initialize();

  G4UImanager* uiManager = G4UImanager::GetUIpointer();
  if (ui != nullptr) {
    uiManager->ApplyCommand("/control/execute vis.mac");
    ui->SessionStart();
    delete ui;
  } else {
    uiManager->ApplyCommand(G4String("/control/execute ") + argv[1]);
  }

  delete visManager;
  delete runManager;
  return 0;
}
