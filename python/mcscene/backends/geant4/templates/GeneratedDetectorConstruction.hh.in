@{header}
//
// Геометрия сцены для Geant4. Этот класс целиком пишет генератор; чтобы что-то
// добавить руками, используйте наследника в user/DetectorConstruction.hh.
#pragma once

#include "G4VUserDetectorConstruction.hh"
#include "g4scene/Registry.hh"

class G4LogicalVolume;
class G4Material;
class G4VPhysicalVolume;

class GeneratedDetectorConstruction : public G4VUserDetectorConstruction {
 public:
  G4VPhysicalVolume* Construct() override;

 protected:
  // Хуки для user/DetectorConstruction.hh. По умолчанию ничего не делают.
  virtual void ConfigureMaterials() {}                    // после BuildMaterials()
  virtual void PostConstruct(G4LogicalVolume* /*world*/) {}  // когда всё построено

  // Материал и логический объём по id из scene.json.
  G4Material* Mat(const G4String& id) const { return fReg.GetMaterial(id); }
  G4LogicalVolume* LV(const G4String& id) const { return fReg.GetVolume(id); }

  scene::Registry fReg;

 private:
  void BuildMaterials();
  G4VPhysicalVolume* BuildWorld();
@{body_decls}
};
