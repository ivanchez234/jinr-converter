{% import "_common.j2" as common with context %}
{{ common.header() }}
//
// Что стенд check_geometry сверяет с Geant4: объёмы тел и пробные точки.
// Пробные точки — в мировых координатах, мм; в каждой должно найтись указанное
// тело с указанным материалом.
#pragma once

#include <vector>

namespace expected {

struct Volume {
  const char* name;   // имя объёма в Geant4
  double cadVolume;   // мм3, из verification.cad_volume
  double relTol;      // допустимое относительное расхождение
};

struct Probe {
  double x, y, z;     // мм, мировые координаты
  const char* volume;
  const char* material;
};

inline constexpr const char* kSceneName = {{ plan.scene_name|cpp_str }};

inline const std::vector<Volume> kVolumes = {
{% for b in bodies %}
    { {{- b.volume|cpp_str }}, {{ b.cad_volume|num }}, {{ b.volume_tol|num }}},
{% endfor %}
};

inline const std::vector<Probe> kProbes = {
{% for b in bodies if b.probes %}
    // {{ b.volume }}: центр и точки у углов
{% for p in b.probes %}
    { {{- p.point|map("num")|join(", ") }}, {{ p.volume|cpp_str }}, {{ p.material|cpp_str }}},
{% endfor %}
{% endfor %}
};

}  // namespace expected
